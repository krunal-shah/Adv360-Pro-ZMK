#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hold_tap_repeat: hold_tap_repeat {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_REPEAT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <400>;
            flavor = "tap-preferred";
        };

        hyper_r_tap: hyper_r_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "HYPER_R_TAP";
            bindings = <&hyper_r>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <400>;
            flavor = "tap-preferred";
        };

        hyper_l: hyper_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings
                = <&macro_press &mo 5 &kp LSHFT &kp LCTRL &kp LALT &kp LGUI>
                , <&macro_pause_for_release>
                , <&macro_release &mo 5 &kp LSHFT &kp LCTRL &kp LALT &kp LGUI>
                ;
        };

        hyper_r: hyper_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            bindings
                = <&macro_press &mo 6 &kp RSHFT &kp RCTRL &kp RALT &kp RGUI>
                , <&macro_pause_for_release>
                , <&macro_release &mo 6 &kp RSHFT &kp RCTRL &kp RALT &kp RGUI>
                ;
        };

        // Re-press LGUI so the masked mods reach the host in their own report before the key
        hyp_kp_l: hyp_kp_l {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            bindings
                = <&macro_press &kp LGUI>
                , <&macro_param_1to1 &macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_1to1 &macro_release &kp MACRO_PLACEHOLDER>
                , <&macro_release &kp LGUI>
                ;
        };

        // Re-press RGUI so the masked mods reach the host in their own report before the key
        hyp_kp_r: hyp_kp_r {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            bindings
                = <&macro_press &kp RGUI>
                , <&macro_param_1to1 &macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_1to1 &macro_release &kp MACRO_PLACEHOLDER>
                , <&macro_release &kp RGUI>
                ;
        };

        hyp_up: hyp_up {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp UP>, <&hyp_kp_l UP>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT)>;
        };

        hyp_down: hyp_down {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOWN>, <&hyp_kp_l DOWN>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT)>;
        };

        hyp_left: hyp_left {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LEFT>, <&hyp_kp_r LEFT>;
            mods = <(MOD_RSFT|MOD_RCTL|MOD_RALT)>;
        };

        hyp_right: hyp_right {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RIGHT>, <&hyp_kp_r RIGHT>;
            mods = <(MOD_RSFT|MOD_RCTL|MOD_RALT)>;
        };

        hyp_space: hyp_space {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp TAB>, <&hyp_kp_l TAB>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT)>;
        };

        hyp_enter: hyp_enter {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(TAB)>, <&hyp_kp_l LS(TAB)>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT)>;
        };

        hyp_lbkt: hyp_lbkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&hyp_kp_l LBKT>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT)>;
        };

        hyp_rbkt: hyp_rbkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RBKT>, <&hyp_kp_l RBKT>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT)>;
        };

        hyp_lbrc: hyp_lbrc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(LBKT)>, <&hyp_kp_l LS(LBKT)>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT)>;
        };

        hyp_rbrc: hyp_rbrc {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(RBKT)>, <&hyp_kp_l LS(RBKT)>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT)>;
        };

        hyp_semi: hyp_semi {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMI>, <&hyp_kp_l SEMI>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT)>;
        };

        hyp_sqt: hyp_sqt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&hyp_kp_l SQT>;
            mods = <(MOD_LSFT|MOD_LCTL|MOD_LALT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                                                                &mo 4      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                                                                 &none      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LGUI              &kp LALT      &kp RCTRL      &kp RGUI                                 &none      &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &lt 1 V    &kp B                                   &kp HOME      &kp PG_UP                                                          &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &hyper_l              &mo 1         &kp PAGE_DOWN  &hyper_r_tap 0 RET                       &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 4      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 4   &kp F7  &kp F8   &kp F9   &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &kp F1   &kp F2   &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &kp F7   &kp F8   &kp F9   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &kp F11  &kp F10  &kp F12  &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans   &trans   &trans   &trans   &trans
            >;
        };

        Shortcuts {
            display-name = "Red";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &tog 1                                                                                                &mo 4      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                                                                 &none      &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LGUI              &kp LALT      &kp RCTRL      &kp RGUI                                 &none      &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &lt 1 V    &kp B                                   &kp HOME      &kp PG_UP                                                          &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp LS(LA(LC(LGUI)))  &mo 1         &kp PAGE_DOWN  &hold_tap_repeat RS(RA(RC(RGUI))) ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 2
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        HYPER_L {
            display-name = "HyperL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                &trans  &trans  &hyp_lbrc  &hyp_rbrc  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans            &trans  &trans  &hyp_lbkt  &hyp_rbkt  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                            &trans  &hyp_semi  &hyp_sqt  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &hyp_enter  &hyp_space    &hyp_up  &hyp_down  &trans  &trans  &trans
            >;
        };

        HYPER_R {
            display-name = "HyperR";
            bindings = <
&trans  &trans  &trans  &trans    &trans     &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans    &trans     &trans  &trans                                     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans    &trans     &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans    &trans     &trans                  &trans  &trans                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &hyp_left &hyp_right         &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans  &trans  &trans  &trans
            >;
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
